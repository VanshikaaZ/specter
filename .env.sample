# Copy to .env.local and fill in. Never commit .env.local.

# ── GitHub (required) ─────────────────────────────────────────────
# Personal access token, public-repo read is enough. Without it you get
# 60 req/hr from GitHub and GhostCommit will die almost immediately.
GITHUB_TOKEN=your_github_token
# Optional: GitHub API base URL, for GitHub Enterprise or a local stand-in in tests
# GITHUB_API_URL=

# ── Supabase (required) ───────────────────────────────────────────
# Tables the code expects: scans, findings, scan_cache (unique on repo_url).
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# Publishable key (sb_publishable_...). Replaces the old "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Secret key (sb_secret_...). Replaces the old "service_role" key.
# Server-only. Used by every API route via supabaseAdmin. Never expose to the client.
SUPABASE_SECRET_KEY=your_supabase_secret_key

# ── App URL (required for local dev) ──────────────────────────────
# The scan trigger calls this URL + /api/scan/<id>/run and sends the internal
# secret to it, so it must be a host you control. The request's Host header is
# NOT trusted in production. Resolution order: NEXT_PUBLIC_APP_URL, then
# https://$VERCEL_URL, then (development only) the request origin.
# Always set it: unset in production it falls back to the upstream deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Internal auth (required in production) ────────────────────────
# Shared secret between the scan trigger and /scan/[id]/run (x-internal-secret header).
# In production, unset means scans are refused (HTTP 500 "Server misconfigured").
# In development it falls back to "specter-internal". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SECRET=change_me_to_a_long_random_string

# ── LLM explanations (set ONE; OpenRouter wins if both are set) ───
# The same key also powers the package check's LLM review of suspicious diffs
# (POST /api/v1/check). Without a key that review is skipped; nothing else changes.
# The free OpenRouter models are small and vary from call to call: for the review,
# set OPENROUTER_MODEL to a stronger model or use Gemini.
OPENROUTER_API_KEY=your_openrouter_key
# Optional. Defaults to "openrouter/free" (auto-picks a free model).
OPENROUTER_MODEL=openrouter/free
# Alternative: Gemini direct (uses gemini-2.0-flash)
GEMINI_API_KEY=

# ── Continuous monitoring (optional) ──────────────────────────────
# GitHub webhook → /api/webhooks/github. Add a webhook on the repo with
# content type application/json, "Push" and "Pull requests" events, and this secret.
# Pull requests that change package-lock.json get a `specter/packages` commit status
# and a comment; GITHUB_TOKEN needs commit-status and pull-request/issue write access.
GITHUB_WEBHOOK_SECRET=
# Telegram alerts when a monitored rescan raises the threat score.
# Create a bot with @BotFather; get your chat id from
# https://api.telegram.org/bot<token>/getUpdates after messaging the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Scheduled rescans → GET /api/monitor/cron with "Authorization: Bearer $CRON_SECRET".
# For repos you can't add a webhook to. Comma-separated owner/repo or URLs.
CRON_SECRET=
MONITORED_REPOS=

# ── Sandbox runner (optional; needs Docker, so it can't run on Vercel) ─
# Where the runner lives (see sandbox-runner/README.md). Unset = the sandbox tier is skipped.
# The runner must be started with the same INTERNAL_SECRET as above.
SANDBOX_RUNNER_URL=
